{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/workbox-(.*).js",
      "dest": "/workbox-.js"
    },
    {
      "src": "/icon-(.*).png",
      "dest": "/icon-.png"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/"
    }
  ]
}
